# ==========================================
# RealEstateHub - Local Development Environment
# ==========================================
# Copy this file to .env:
# cp .env.example .env

# --- PostgreSQL Database ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=realestate_hub_dev
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/realestate_hub_dev?schema=public

# --- MongoDB Database ---
MONGO_ROOT_USER=mongo
MONGO_ROOT_PASSWORD=mongo
MONGO_DB=realestate_reviews
MONGO_PORT=27017
MONGO_URI=mongodb://mongo:mongo@localhost:27017/realestate_reviews?authSource=admin

# --- Redis Cache ---
REDIS_PORT=6379
REDIS_PASSWORD=redispassword
REDIS_URL=redis://:redispassword@localhost:6379

# --- Backend API ---
PORT=5000
JWT_SECRET=supersecretjwtkey_change_in_production_123456789
JWT_EXPIRES_IN=7d

# --- Recommendation Service (Python FastAPI) ---
RECOMMENDER_PORT=8000
RECOMMENDER_SERVICE_URL=http://localhost:8000
