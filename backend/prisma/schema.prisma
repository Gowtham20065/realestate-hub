datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  BUYER
  AGENT
}

enum ListingType {
  RENT
  SALE
}

enum PropertyStatus {
  AVAILABLE
  PENDING
  SOLD
  RENTED
}

enum InquiryStatus {
  PENDING
  CONTACTED
  RESOLVED
}

enum InteractionType {
  VIEW
  SAVE
  INQUIRY
}

model User {
  id           String             @id @default(uuid())
  name         String
  email        String             @unique
  passwordHash String             @map("password_hash")
  role         Role               @default(BUYER)
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  properties       Property[]
  savedProperties  SavedProperty[]
  inquiries        Inquiry[]
  userInteractions UserInteraction[]

  @@map("users")
}

model Property {
  id           String         @id @default(uuid())
  agentId      String         @map("agent_id")
  agent        User           @relation(fields: [agentId], references: [id], onDelete: Cascade)
  title        String
  description  String         @db.Text
  price        Decimal        @db.Decimal(12, 2)
  propertyType String         @map("property_type") // HOUSE, APARTMENT, CONDO, TOWNHOUSE, VILLA
  listingType  ListingType    @map("listing_type")
  bedrooms     Int
  bathrooms    Float
  sqft         Int
  city         String
  state        String
  address      String
  latitude     Float?
  longitude    Float?
  imageUrls    String[]       @map("image_urls")
  status       PropertyStatus @default(AVAILABLE)
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  savedBy          SavedProperty[]
  inquiries        Inquiry[]
  userInteractions UserInteraction[]

  @@index([city, status])
  @@index([price])
  @@index([bedrooms])
  @@index([propertyType, listingType])
  @@index([agentId])
  @@map("properties")
}

model SavedProperty {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  propertyId String   @map("property_id")
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([userId, propertyId])
  @@index([userId])
  @@index([propertyId])
  @@map("saved_properties")
}

model Inquiry {
  id         String        @id @default(uuid())
  userId     String        @map("user_id")
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  propertyId String        @map("property_id")
  property   Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  message    String        @db.Text
  status     InquiryStatus @default(PENDING)
  createdAt  DateTime      @default(now()) @map("created_at")

  @@index([userId])
  @@index([propertyId])
  @@map("inquiries")
}

model UserInteraction {
  id         String          @id @default(uuid())
  userId     String?         @map("user_id")
  user       User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  propertyId String          @map("property_id")
  property   Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  actionType InteractionType @map("action_type")
  createdAt  DateTime        @default(now()) @map("created_at")

  @@index([userId, actionType])
  @@index([propertyId])
  @@map("user_interactions")
}
